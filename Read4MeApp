# Function to download files from Google Drive
def download_from_google_drive(file_id, save_path):
    try:
        service = authenticate_google_drive()
        request = service.files().get_media(fileId=file_id)
        with open(save_path, 'wb') as f:
            downloader = MediaIoBaseDownload(f, request)
            done = False
            while done is False:
                status, done = downloader.next_chunk()
        messagebox.showinfo("Success", f"File downloaded to {save_path}")
    except Exception as e:
        messagebox.showerror("Error", f"File download failed: {str(e)}")

# Function to authenticate and upload to Dropbox
def upload_to_dropbox(file_path):
    try:
        dbx = dropbox.Dropbox('YOUR_ACCESS_TOKEN')
        with open(file_path, "rb") as f:
            dbx.files_upload(f.read(), '/' + os.path.basename(file_path))
        messagebox.showinfo("Success", f"File uploaded to Dropbox: {os.path.basename(file_path)}")
    except Exception as e:
        messagebox.showerror("Error", f"Dropbox upload failed: {str(e)}")

# Function to download from Dropbox
def download_from_dropbox(file_path, save_path):
    try:
        dbx = dropbox.Dropbox('YOUR_ACCESS_TOKEN')
        dbx.files_download_to_file(save_path, '/' + file_path)
        messagebox.showinfo("Success", f"File downloaded from Dropbox to {save_path}")
    except Exception as e:
        messagebox.showerror("Error", f"Dropbox download failed: {str(e)}")

# Function to upload to AWS S3
def upload_to_s3(file_path, bucket_name):
    try:
        s3 = boto3.client('s3')
        with open(file_path, 'rb') as f:
            s3.upload_fileobj(f, bucket_name, os.path.basename(file_path))
        messagebox.showinfo("Success", f"File uploaded to S3: {os.path.basename(file_path)}")
    except Exception as e:
        messagebox.showerror("Error", f"S3 upload failed: {str(e)}")

# Function to download from AWS S3
def download_from_s3(file_name, bucket_name, save_path):
    try:
        s3 = boto3.client('s3')
        s3.download_file(bucket_name, file_name, save_path)
        messagebox.showinfo("Success", f"File downloaded from S3 to {save_path}")
    except Exception as e:
        messagebox.showerror("Error", f"S3 download failed: {str(e)}")

