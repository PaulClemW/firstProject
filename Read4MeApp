# Function to start Real-Time OCR
def start_real_time_ocr():
    try:
        cap = cv2.VideoCapture(0)  # Open webcam
        if not cap.isOpened():
            raise Exception("Camera not found or failed to open.")
        
        while True:
            ret, frame = cap.read()
            if not ret:
                break
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            text = pytesseract.image_to_string(gray)
            cv2.putText(frame, text, (50, 50), cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 255, 0), 2, cv2.LINE_AA)
            cv2.imshow('OCR', frame)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                break
        cap.release()
        cv2.destroyAllWindows()
    except Exception as e:
        messagebox.showerror("Error", f"Real-Time OCR failed: {str(e)}")

# Function to start Background Reading
def background_read(text):
    engine = pyttsx3.init()
    engine.say(text)
    engine.runAndWait()

def start_background_reading():
    try:
        text = text_display.get(1.0, tk.END)  # Get text from text box
        if text.strip() == "":
            raise ValueError("No text available to read.")
        reading_thread = threading.Thread(target=background_read, args=(text,))
        reading_thread.start()
    except Exception as e:
        messagebox.showerror("Error", f"Background reading failed: {str(e)}")

