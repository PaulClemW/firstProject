# File Dialogs for Upload/Download
def upload_file():
    file_path = filedialog.askopenfilename(title="Select File to Upload")
    if file_path:
        file_name = os.path.basename(file_path)
        upload_to_google_drive(file_path, file_name)

def download_file():
    file_id = filedialog.askstring("File ID", "Enter File ID for Download")
    save_path = filedialog.asksaveasfilename(defaultextension=".txt", filetypes=[("Text Files", "*.txt")])
    if file_id and save_path:
        download_from_google_drive(file_id, save_path)

